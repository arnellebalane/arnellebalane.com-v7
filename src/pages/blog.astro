---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticlesSection from '../components/sections/ArticlesSection.astro';

const articles = await getCollection('articles');
const articlesSorted = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Writing">
    <div class="flex flex-col gap-10 sm:gap-20 pt-10 sm:pt-12 pb-36 sm:pb-62">
        <h1 class="text-3xl sm:text-5xl font-semibold leading-none text-center">Writing</h1>

        <ArticlesSection articles={articlesSorted} />
    </div>
</BaseLayout>
