---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticlesSection from '../components/sections/ArticlesSection.astro';
import type { CollectionEntry } from 'astro:content';

const articles = await getCollection('articles');
const sortedArticles = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredArticles: CollectionEntry<'articles'>[] = [];
const otherArticles: CollectionEntry<'articles'>[] = [];
for (const article of sortedArticles) {
    if (article.data.featured && featuredArticles.length === 0) {
        featuredArticles.push(article);
    } else {
        otherArticles.push(article);
    }
}
---

<BaseLayout title="Writing">
    <div class="flex flex-col gap-10 sm:gap-20 pt-10 sm:pt-12 pb-36 sm:pb-62">
        <h1 class="text-3xl sm:text-5xl font-semibold leading-none text-center">Writing</h1>

        <div class="flex flex-col gap-5 md:gap-20">
            {featuredArticles.length > 0 && <ArticlesSection articles={featuredArticles} featured />}
            <ArticlesSection articles={otherArticles} />
        </div>
    </div>
</BaseLayout>
