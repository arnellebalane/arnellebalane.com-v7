---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Project from '../components/Project.astro';

const projects = await getCollection('projects');
---

<BaseLayout title="Projects">
    <div class="flex flex-col gap-10 sm:gap-20 pt-10 sm:pt-12 pb-36">
        <h1 class="text-3xl sm:text-5xl font-semibold leading-none text-center">Projects</h1>

        <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 2xl:grid-cols-3">
            {projects.map(({ data: project }) => <Project project={project} />)}
        </ul>

        <p class="text-xl text-center">
            ...and many more in my
            <a
                href="https://github.com/arnellebalane?tab=repositories"
                class="text-primary hover:underline focus:underline"
                target="_blank"
                rel="noopener noreferrer"
            >
                GitHub profile
            </a>
        </p>
    </div>
</BaseLayout>
