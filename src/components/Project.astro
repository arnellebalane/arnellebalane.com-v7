---
import type { InferEntrySchema } from 'astro:content';

interface Props {
    project: InferEntrySchema<'projects'>;
}
const { project } = Astro.props;
---

<li class="flex flex-col rounded bg-slate-50">
    <div class="flex flex-col grow p-5 border-b border-b-slate-200">
        <h2 class="mb-3 text-xl font-semibold">{project.name}</h2>
        <p class="mb-8 text-zinc-600">{project.description}</p>

        <ul class="flex flex-wrap gap-x-4 mt-auto">
            {project.tags.map((tag) => <li class="text-base text-zinc-600">{tag}</li>)}
        </ul>
    </div>

    <div class="flex gap-1 px-5 py-2 -mx-2">
        {
            project.repo_url && (
                <a
                    href={project.repo_url}
                    class="text-base text-primary px-2 py-1 rounded outline-offset-2 hover:bg-slate-200 focus:bg-slate-200"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    View repo
                </a>
            )
        }

        {
            project.project_url && (
                <a
                    href={project.project_url}
                    class="text-base text-primary px-2 py-1 rounded outline-offset-2 hover:bg-slate-200 focus:bg-slate-200"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    View project
                </a>
            )
        }
    </div>
</li>
