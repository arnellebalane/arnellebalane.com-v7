---
import type { CollectionEntry } from 'astro:content';
import Article from '../Article.astro';

interface Props {
    articles: CollectionEntry<'articles'>[];
    featured?: boolean;
}
const { articles, featured } = Astro.props;
---

<section>
    <ol class:list={['grid grid-cols-1 gap-5 md:gap-x-6 md:gap-y-14', { 'md:grid-cols-2 2xl:grid-cols-3': !featured }]}>
        {articles.map((article) => <Article article={article} featured={featured} />)}
    </ol>
</section>
