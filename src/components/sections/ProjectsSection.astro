---
import type { InferEntrySchema } from 'astro:content';
import Project from '../Project.astro';

interface Props {
    title: string;
    projects: InferEntrySchema<'projects'>[];
}
const { title, projects } = Astro.props;
---

<section>
    <h2 class="text-2xl sm:text-3xl font-semibold mb-5 sm:mb-8">{title}</h2>

    <ul class="grid grid-cols-1 gap-5 md:gap-6 md:grid-cols-2 2xl:grid-cols-3">
        {projects.map((project) => <Project project={project} />)}
    </ul>
</section>
