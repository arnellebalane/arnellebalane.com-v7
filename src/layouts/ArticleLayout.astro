---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CalendarIcon from '../components/icons/CalendarIcon.astro';
import '../styles/article.css';

const { frontmatter, url } = Astro.props;
const articleDate = new Date(frontmatter.date).toLocaleDateString('en-US', {
    dateStyle: 'long',
    timeZone: 'Asia/Manila',
});
const articleUrl = import.meta.env.SITE + url;
const articleImage = import.meta.env.SITE + frontmatter.cover_image;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{frontmatter.title} | Arnelle Balane</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Ubuntu+Mono:wght@400;700&display=swap"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="description" content={frontmatter.summary} />
        <meta property="og:title" content={frontmatter.title} />
        <meta property="og:type" content="article" />
        <meta property="og:url" content={articleUrl} />
        <meta property="og:image" content={articleImage} />
        <meta name="generator" content={Astro.generator} />
    </head>

    <body class="text-lg text-copy tracking-tight antialiased bg-slate-100">
        <Header />

        <article
            class="flex flex-col gap-10 sm:gap-12 box-content max-w-3xl mx-auto px-5 pt-10 sm:pt-12 pb-36 sm:pb-62"
        >
            <header>
                <h1 class="mb-5 text-3xl sm:text-5xl font-semibold leading-none">{frontmatter.title}</h1>
                <time datetime={frontmatter.date} class="flex items-center gap-2">
                    <CalendarIcon class="size-5" />
                    {articleDate}
                </time>
            </header>

            <div class="app-article flex flex-col gap-6 text-xl">
                <slot />
            </div>
        </article>

        <Footer />
    </body>
</html>
