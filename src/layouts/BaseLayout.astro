---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
    title?: string;
}
const { title } = Astro.props;

const prefix = title ? `${title} | ` : '';
const formattedTitle = `${prefix}Arnelle Balane`;

const isHomeRoute = Astro.url.pathname === '/';
const pageUrl = `${import.meta.env.SITE}${Astro.url.pathname}`;
const pageImageUrl = `${import.meta.env.SITE}/social-share.jpg`;
const appDomain = new URL(import.meta.env.SITE).hostname;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{formattedTitle}</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" />
        <link rel="icon" type="image/svg+xml" href="/favicon.png" />
        <meta name="description" content="Arnelle is a software engineer based in Seattle." />
        <meta property="og:title" content={formattedTitle} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={pageImageUrl} />
        <meta name="generator" content={Astro.generator} />
    </head>

    <body class="text-lg text-copy tracking-tight antialiased bg-slate-100">
        <Header isHomeRoute={isHomeRoute} />

        <div class="box-content max-w-6xl px-5 mx-auto">
            <slot />
        </div>

        {!isHomeRoute && <Footer />}

        <script
            is:inline
            defer
            src="https://umami.arnelle.dev/script.js"
            data-website-id="de64ab62-0f3c-4f6b-847b-2b00e2acb4bf"
            data-domains={appDomain}
            data-do-not-track="true"></script>
    </body>
</html>
